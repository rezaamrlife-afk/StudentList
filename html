  { name: "EREN AKDENİZ", level: "A1.3", time: "SA-SU", status: "KY" },
  { name: "EMİR AKDENİZ", level: "A1.3", time: "SA-SU", status: "KY" },
  { name: "ELİF RÜYA BİLGİSEVEN", level: "A2.2", time: "MW", status: "KY" },
  { name: "TOPRAK KARABEKİR", level: "A2.3", time: "SA", status: "KY" },
  { name: "YAMAN KARATAŞ", level: "BELİRSİZ", time: "MW", status: "YK" },
  { name: "KEREM GÜNEY AKSAKAL", level: "A1.3", time: "SA", status: "KY" },
