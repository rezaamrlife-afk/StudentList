  { name: "EYMEN TAHA ALTIN", level: "BELİRSİZ", time: "TT", status: "YK" },
  { name: "DEMİR KENAN CEYLAN", level: "A1.2", time: "SU", status: "YK" },
  { name: "İLBER EMİR AKGÜN", level: "A1.2", time: "SU", status: "YK" },
  { name: "DUA MEYRA AKGÜN", level: "A2.2", time: "SU", status: "YK" },
  { name: "MİRAÇ DEMİR", level: "A2.3", time: "SA", status: "KY" },
  { name: "DERİN YILMAZ", level: "A1.2", time: "MW", status: "YK" },
  { name: "AYŞE ELİF DOĞAN", level: "A1.3", time: "TT", status: "" },
  { name: "HASAN KÜÇÜK", level: "B2.1", time: "MW", status: "KY" },
  { name: "HATİCE ÖZKULOĞLU", level: "A2.1", time: "FS", status: "KY" },
  { name: "ASLI YANIK", level: "B1.2", time: "SA", status: "KY" },
  { name: "AHMET SİNAN CAYLI", level: "A2.1", time: "?", status: "YK" },
  { name: "ELİF NİL BULUT", level: "A2.1", time: "?", status: "YK" },
  { name: "DİLEM ÖZBEY", level: "B1.1", time: "TT", status: "YK" },
  { name: "ALİ YİĞİT SERTEL", level: "BELİRSİZ", time: "SU", status: "YK" },
  { name: "BEDİRHAN KOPAN", level: "B1.2", time: "MW", status: "KY" },
  { name: "ELİF DURU USLU", level: "B1.1", time: "SA", status: "KY" },
  { name: "ATAKAN GÖÇEN", level: "A2.1", time: "SA", status: "YK" },
];

const groups = [
  { key: "MW", label: "MW", days: "Monday & Wednesday", color: "#6c8ef5" },
  { key: "TT", label: "TT", days: "Tuesday & Thursday", color: "#e87040" },
  { key: "SA", label: "SA", days: "Saturday", color: "#4caf82" },
  { key: "SU", label: "SU", days: "Sunday", color: "#b06cf5" },
];

function getInitials(name) {
  const parts = name.trim().split(" ");
  return (parts[0][0] + (parts[1] ? parts[1][0] : "")).toUpperCase();
}

function getStudentsForGroup(groupKey) {
  return data.filter(s => {
    const t = s.time.toUpperCase();
    if (groupKey === "MW") return t.includes("MW");
    if (groupKey === "TT") return t.includes("TT");
    if (groupKey === "SA") return t === "SA" || t === "SA-SU";
    if (groupKey === "SU") return t === "SU" || t === "SA-SU";
    return false;
  });
}

function groupByLevel(students) {
  const map = {};
  students.forEach(s => {
    if (!map[s.level]) map[s.level] = [];
    map[s.level].push(s);
  });
  const order = ["A1.1","A1.2","A1.3","A2.1","A2.2","A2.3","A2.3 mini","B1.1","B1.2","B1.3","B2.1","BELİRSİZ"];
  return Object.entries(map).sort(([a],[b]) => {
    const ai = order.indexOf(a); const bi = order.indexOf(b);
    return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
  });
}

function renderSlide(groupIdx) {
  const g = groups[groupIdx];
  const students = getStudentsForGroup(g.key);
  const byLevel = groupByLevel(students);
  const badge = document.getElementById("group-badge");
  const daysLabel = document.getElementById("days-label");
  badge.textContent = g.label;
  badge.style.background = g.color;
  daysLabel.textContent = g.days;

  const content = document.getElementById("slide-content");
  content.innerHTML = `
    <div class="slide-header">
      <div class="group-title">${g.days}</div>
      <div class="group-meta">
        <div class="meta-chip"><span class="label">Students</span><span class="value">${students.length}</span></div>
        <div class="teacher-chip">Teacher: TBD</div>
      </div>
    </div>
    <div class="levels-grid">${byLevel.map(([level, sts]) => `
      <div class="level-card">
        <div class="level-card-header">
          <span class="level-name">${level}</span>
          <span class="level-count">${sts.length}</span>
        </div>
        <div class="student-list">${sts.map(s => `
          <div class="student-row">
            <div class="avatar">${getInitials(s.name)}</div>
            <div class="student-name">${s.name}</div>
            <div class="status-dot ${s.status === 'KY' ? 'ky' : 'yk'}"></div>
          </div>
        `).join("")}</div>
      </div>
    `).join("")}</div>
  `;

  document.getElementById("slide-counter").textContent = `${groupIdx + 1} / ${groups.length}`;

  const dots = document.querySelectorAll(".dot");
  dots.forEach((d, i) => d.classList.toggle("active", i === groupIdx));
}

function buildDots() {
  const wrap = document.getElementById("nav-dots");
  groups.forEach((g, i) => {
    const d = document.createElement("div");
    d.className = "dot" + (i === 0 ? " active" : "");
    d.title = g.days;
    d.addEventListener("click", () => { currentSlide = i; resetTimer(); renderSlide(i); });
    wrap.appendChild(d);
  });
}

const SLIDE_DURATION = 15000;
let currentSlide = 0;
let paused = false;
let elapsed = 0;
let lastTick = null;
let raf = null;

function resetTimer() {
  elapsed = 0;
  lastTick = performance.now();
}

function tick(now) {
  if (!paused) {
    if (lastTick) elapsed += now - lastTick;
    lastTick = now;
    const pct = Math.max(0, 100 - (elapsed / SLIDE_DURATION) * 100);
    document.getElementById("timer-bar").style.width = pct + "%";
    if (elapsed >= SLIDE_DURATION) {
      currentSlide = (currentSlide + 1) % groups.length;
      renderSlide(currentSlide);
      elapsed = 0;
    }
  } else {
    lastTick = now;
  }
  raf = requestAnimationFrame(tick);
}

document.getElementById("btn-pause").addEventListener("click", () => {
  paused = !paused;
  document.getElementById("btn-pause").textContent = paused ? "▶ Resume" : "⏸ Pause";
});

buildDots();
renderSlide(0);
resetTimer();
raf = requestAnimationFrame(tick);
</script>
