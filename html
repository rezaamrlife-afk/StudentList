  { name: "ADA AKIN", level: "A2.2", time: "SS", status: "KY" },
  { name: "ADA NİDA ÖZDEMİR", level: "A2.1", time: "SA", status: "KY" },
  { name: "DOĞU POYRAZ ERYILMAZ", level: "A2.3 mini", time: "MW", status: "KY" },
  { name: "MUHAMMED EMİR BİÇİCİ", level: "A2.1", time: "MW", status: "KY" },
  { name: "ALİ YAMAN ALTUN", level: "A2.3", time: "SA", status: "KY" },
  { name: "ECRİN ALTUN", level: "A2.3", time: "SA", status: "KY" },
  { name: "AZRA MELEK ÖNCEL", level: "A2.1", time: "SA", status: "KY" },
  { name: "MUSTAFA SAİT GÜLER", level: "A2.1", time: "SA", status: "KY" },
  { name: "RÜZGAR TUNÇ", level: "A2.3 mini", time: "MW", status: "KY" },
  { name: "AREL DENİZ EROĞLAN", level: "B1.3", time: "MW", status: "KY" },
  { name: "MERVE AYDEMİR", level: "B1.2", time: "MW", status: "KY" },
  { name: "ELİF AYDEMİR", level: "B1.1", time: "MW", status: "KY" },
  { name: "AYŞE MİNA TUNÇ", level: "A1.3", time: "TT", status: "KY" },
  { name: "ALİ MERT TUNÇ", level: "A1.3", time: "TT", status: "KY" },
  { name: "ZEYNEP BEREN GÜNTAY", level: "A2.1", time: "MW", status: "KY" },
